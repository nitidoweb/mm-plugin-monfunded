{
  "name": "mm-plugin-monfunded",
  "version": "0.2.0",
  "private": true,
  "description": "MonFunded for MetaMask Agent Wallet: an AI agent buys a MonFunded assessment, trades it and claims its payouts with the mm CLI, on Monad.",
  "homepage": "https://monfunded.com/agents/",
  "type": "module",
  "keywords": [
    "oclif-plugin",
    "metamask",
    "agent-wallet",
    "monfunded",
    "monad"
  ],
  "engines": {
    "node": ">=24"
  },
  "files": [
    "dist",
    "SKILL.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --test test/*.test.ts",
    "test:e2e": "node test/e2e.ts"
  },
  "oclif": {
    "bin": "mm",
    "commands": "./dist/commands",
    "topicSeparator": " ",
    "topics": {
      "monfunded": {
        "description": "MonFunded, a prop-trading firm on Monad: buy an assessment, trade it, withdraw and claim payouts"
      }
    }
  },
  "mm": {
    "schemaVersion": 1,
    "minCliVersion": "^6.2.0",
    "capabilities": [],
    "commands": [
      {
        "id": "monfunded:login",
        "capabilities": [
          "wallet-read",
          "wallet-submit"
        ],
        "dataAccess": [
          "accounts"
        ],
        "targetChains": [
          143
        ]
      },
      {
        "id": "monfunded:buy",
        "capabilities": [
          "wallet-read",
          "wallet-submit"
        ],
        "dataAccess": [
          "accounts",
          "balances"
        ],
        "targetChains": [
          143
        ]
      },
      {
        "id": "monfunded:status",
        "capabilities": [
          "wallet-read"
        ],
        "dataAccess": [
          "accounts"
        ],
        "targetChains": [
          143
        ]
      },
      {
        "id": "monfunded:coach",
        "capabilities": [
          "wallet-read"
        ],
        "dataAccess": [
          "accounts"
        ],
        "targetChains": [
          143
        ]
      },
      {
        "id": "monfunded:order",
        "capabilities": [
          "wallet-read"
        ],
        "dataAccess": [
          "accounts"
        ],
        "targetChains": [
          143
        ]
      },
      {
        "id": "monfunded:close",
        "capabilities": [
          "wallet-read"
        ],
        "dataAccess": [
          "accounts"
        ],
        "targetChains": [
          143
        ]
      },
      {
        "id": "monfunded:withdraw",
        "capabilities": [
          "wallet-read"
        ],
        "dataAccess": [
          "accounts"
        ],
        "targetChains": [
          143
        ]
      },
      {
        "id": "monfunded:claim",
        "capabilities": [
          "wallet-read",
          "wallet-submit"
        ],
        "dataAccess": [
          "accounts"
        ],
        "targetChains": [
          143
        ]
      }
    ]
  },
  "allowScripts": {
    "yarn": false
  },
  "overrides": {
    "tmp": "^0.2.7"
  },
  "dependencies": {
    "viem": "2.56.8"
  },
  "devDependencies": {
    "@ethereumjs/common": "^10.1.3",
    "@ethereumjs/evm": "^10.1.3",
    "@ethereumjs/util": "^10.1.3",
    "@metamask/agent-wallet": "^6.2.1",
    "@types/node": "26.6.2",
    "solc": "^0.8.37",
    "typescript": "7.0.2"
  }
}
